{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ssot/qa-report.schema.json",
  "title": "Visual QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "qaId",
    "assetId",
    "sourceSha256",
    "lockMode",
    "scores",
    "weightedScore",
    "status",
    "hardVetoFindings",
    "humanDecision",
    "reviewedAt"
  ],
  "allOf": [
    {
      "if": { "type": "object", "properties": { "schemaVersion": { "const": "2.0.0" } }, "required": ["schemaVersion"] },
      "then": { "type": "object", "properties": { "findings": {} }, "required": ["findings"] },
      "else": { "not": { "type": "object", "properties": { "findings": {} }, "required": ["findings"] } }
    }
  ],
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": ["1.0.0", "2.0.0"]
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description", "unlocalized"],
        "properties": {
          "severity": { "enum": ["BLOCKER", "WARN", "INFO"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "unlocalized": { "type": "boolean" },
          "sourceRegion": { "$ref": "#/$defs/region" },
          "outputRegion": { "$ref": "#/$defs/region" }
        },
        "allOf": [{
          "if": { "type": "object", "properties": { "unlocalized": { "const": true } }, "required": ["unlocalized"] },
          "then": { "not": { "anyOf": [{ "type": "object", "properties": { "sourceRegion": {} }, "required": ["sourceRegion"] }, { "type": "object", "properties": { "outputRegion": {} }, "required": ["outputRegion"] }] } },
          "else": { "anyOf": [{ "type": "object", "properties": { "sourceRegion": {} }, "required": ["sourceRegion"] }, { "type": "object", "properties": { "outputRegion": {} }, "required": ["outputRegion"] }] }
        }]
      }
    },
    "qaId": {
      "type": "string",
      "format": "uuid"
    },
    "assetId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockMode": {
      "enum": [
        "STRICT",
        "BALANCED",
        "CREATIVE"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "typography",
        "geometry",
        "realism",
        "style"
      ],
      "properties": {
        "design": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "typography": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "geometry": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "realism": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "style": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "weightingVariant": {
      "enum": [
        "default",
        "unbranded"
      ]
    },
    "weightedScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "enum": [
        "PASS_CANDIDATE",
        "REVIEW_REQUIRED",
        "UNVERIFIABLE",
        "REJECTED"
      ]
    },
    "hardVetoFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "WARN",
              "INFO"
            ]
          }
        }
      }
    },
    "humanDecision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewerNote": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
