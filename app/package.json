{
  "name": "product-image-studio",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:ui && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "gateway": "node gateway.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "check:ui": "node scripts/build-tokens.mjs --check && node scripts/check-ui-ssot.mjs",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.115",
    "@zip.js/zip.js": "2.24.0",
    "ai": "7.0.170",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.72.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
}
