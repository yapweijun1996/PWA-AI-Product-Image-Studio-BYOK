# Local development reference only. The gateway does not automatically load .env files.
# It binds to 127.0.0.1; billable image generation is disabled by default.
# Configure process variables as described in README.md. Keep real provider keys out
# of the browser and repository, and do not expose this development gateway publicly.
# Explicitly enabling image generation can incur real charges; do not enable it
# or use a real key until the required isolation and security reviews are complete.
STUDIO_ACCESS_TOKEN_SHA256=
OPENAI_API_KEY=
